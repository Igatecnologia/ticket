# ============================================
# Chatwoot - Iga Tecnologia
# Copie este arquivo para .env e preencha
# ============================================

# Gere com: openssl rand -hex 64
SECRET_KEY_BASE=TROCAR_AQUI

# URL do sistema
# Desenvolvimento: http://localhost:3000
# Producao Iga:    https://suporte.igatech.com.br
FRONTEND_URL=https://suporte.igatech.com.br

# Idioma padrao
DEFAULT_LOCALE=pt_BR

# Desabilitar cadastro publico
ENABLE_ACCOUNT_SIGNUP=false

# SSL (true em producao atras de Nginx + Certbot)
FORCE_SSL=true

# ============================================
# BANCO DE DADOS
# ============================================
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
# Gere com: openssl rand -base64 20 | tr -d "=+/"
POSTGRES_PASSWORD=TROCAR_AQUI

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ============================================
# SMTP (configurar para envio de e-mails)
# ============================================
# Gmail exemplo:
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=seu-email@gmail.com
# SMTP_PASSWORD=sua-app-password
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true

SMTP_ADDRESS=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=true
MAILER_SENDER_EMAIL=Iga Tecnologia <suporte@igatecnologia.com>

# ============================================
# RAILS
# ============================================
RAILS_ENV=production
RAILS_MAX_THREADS=5
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# ============================================
# STORAGE (padrao: local)
# ============================================
ACTIVE_STORAGE_SERVICE=local

# Para usar Amazon S3:
# ACTIVE_STORAGE_SERVICE=amazon
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# ============================================
# INTEGRACOES (opcional)
# ============================================
# Facebook/Instagram
# FB_VERIFY_TOKEN=
# FB_APP_SECRET=
# FB_APP_ID=

# WhatsApp Cloud API (configurar pelo painel)

# Slack
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# Push Notifications
ENABLE_PUSH_RELAY_SERVER=true
